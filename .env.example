DISCORD_TOKEN=your_discord_bot_token_here

# Optional first-run default. You can set this later with /setchannel.
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# Optional. Register slash commands instantly in one server.
# Without this, Discord global slash commands can take a while to appear.
DISCORD_GUILD_ID=your_discord_server_id_here

# Optional. Bot checks every 60 seconds by default.
CHECK_INTERVAL_SECONDS=60

# Automatic agency roster sync (server credentials only; never put these in Discord).
# Uses the existing private import_member_roster RPC and agency-live-watchlist feed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Railway: mount this service's persistent volume at /data and set DATA_DIR=/data.
# Leave empty locally to store files in the working directory.
DATA_DIR=

# Optional. Only use if TikTok starts blocking anonymous LIVE checks.
TIKTOK_SESSION_ID=
TIKTOK_TT_TARGET_IDC=

# Agency uploads only (@aetheragencytt), independent of the LIVE watchlist.
# Leave blank until TikTok approves Display API access and the agency authorises video.list.
# Set the channel here or with /setvideochannel.
AGENCY_VIDEO_CHANNEL_ID=
AGENCY_TIKTOK_CLIENT_KEY=
AGENCY_TIKTOK_CLIENT_SECRET=
AGENCY_TIKTOK_REFRESH_TOKEN=
# Optional short-lived alternative for testing; expires and requires replacement.
AGENCY_TIKTOK_ACCESS_TOKEN=
